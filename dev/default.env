# Defaults of the dev environment: fixed ports, no tooling needed.
# `npm run dev-deps` copies this file to .env when there is none; .env overrides it
# (it is never overwritten, edit it freely).
# Ports stay in 5900-5949 so that they rarely collide with other local services.
DEV_HOST=localhost
# the dev servers are on loopback: allowed to the SSRF-safe http clients of the api, the worker and the tests
SSRF_PUBLIC_IPS=127.0.0.1,::1
NGINX_PORT=5900
DEV_API_PORT=5901
DEV_UI_PORT=5902
DEV_UI_HMR_PORT=5903
# the prometheus observers of the api and the worker (the worker's /metrics is its readiness probe)
DEV_API_OBSERVER_PORT=5904
DEV_WORKER_OBSERVER_PORT=5905
MONGO_PORT=5906
ES_PORT=5907
SD_PORT=5908
# the data-fair API, where the plugins write their datasets through the worker
DF_PORT=5909
# the registry API, where the api and the worker get the plugins
REGISTRY_PORT=5910
# optional services, the docker compose profiles events, openapi-viewer and maildev
# (npm run dev -- --profile events). Without the events container the api and the worker log a failure per
# pushed event
EVENTS_PORT=5911
OAV_PORT=5912
MAILDEV_UI_PORT=5913
MAILDEV_SMTP_PORT=5914
