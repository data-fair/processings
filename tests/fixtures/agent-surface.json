    {
      "name": "form_describeState",
      "description": "Describe the form: every field with its path, type, constraints, current value and errors. Pass \"path\" to describe one subtree instead of the whole form; what is too large to describe whole is answered as an outline. Each option of a choice is listed with the fields it brings, and a path to an option not chosen (\".../$oneOf/2\") or to an item of a list still empty describes what it would hold. To find a field without knowing which tab holds it, pass \"query\" with words of its name.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "form": {
            "type": "string",
            "enum": [
              "processing_config"
            ],
            "description": "The form this call edits. \"processing_config\": Processing config. A form keeps its edits between calls with the same form and parameters."
          },
          "id": {
            "type": "string",
            "description": "Id of the processing."
          },
          "path": {
            "type": "string",
            "description": "Node path as returned by describeState (e.g. \"/address/city\"). Omit for the whole tree. It may name what does not exist yet: an option not chosen (\"/menu/0/$oneOf/2\"), or an item of a list still empty (\"/menu/0\")."
          },
          "query": {
            "type": "string",
            "description": "Words to look for instead of describing: lists the fields (under \"path\" if given) whose key, title, help or short text value holds all of them, accents and case apart, including those a condition hides."
          }
        },
        "required": [
          "form",
          "id"
        ]
      },
      "annotations": {
        "title": "Processing config — form state",
        "readOnlyHint": true,
        "openWorldHint": false
