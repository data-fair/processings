    {
      "name": "form_getFieldSuggestions",
      "description": "Get the accepted values of a field of the form that describeState marked \"suggestions\", optionally filtered by a query. A field whose values describeState already stated on its line as values=[...] needs no call — write one of them. Each option comes back with an index and a title; one whose value is not a short scalar is listed by title alone, exactly as a user sees it. To choose one, call setFieldValue with the same path, \"suggestionIndex\" set to its index and \"suggestionTitle\" to its title as listed, and the full original value is applied.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "form": {
            "type": "string",
            "enum": [
              "processing_config"
            ],
            "description": "The form this call edits. \"processing_config\": Processing config. A form keeps its edits between calls with the same form and parameters."
          },
          "id": {
            "type": "string",
            "description": "Id of the processing."
          },
          "path": {
            "type": "string",
            "description": "Node path as returned by describeState (e.g. \"/address/city\")."
          },
          "query": {
            "type": "string",
            "description": "Search query to filter suggestions"
          }
        },
        "required": [
          "form",
          "id",
          "path"
        ]
