    {
      "name": "update_processing",
      "description": "Rename a processing, activate or deactivate it, or replace its scheduling, the whole list of its schedules ([] for on-demand runs only). Only the parts sent change. Activation needs a valid config, edited with the form_* tools (form \"processings_processing_config\").",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Id of the processing."
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "active": {
            "title": "Active",
            "type": "boolean"
          },
          "scheduling": {
            "type": "array",
            "title": "Processing scheduling",
            "items": {
              "title": "Scheduling",
              "type": "object",
              "required": [
                "type",
                "month",
                "dayOfWeek",
                "dayOfMonth",
                "hour",
                "minute"
              ],
              "oneOf": [
                {
                  "title": "Monthly",
                  "properties": {
                    "type": {
                      "const": "monthly"
                    },
                    "dayOfWeek": {
                      "const": "*"
                    },
                    "dayOfMonth": {
                      "title": "Day of the Month",
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 28,
                      "default": 1
                    },
                    "lastDayOfMonth": {
                      "title": "Last Day of the Month",
                      "type": "boolean",
                      "default": false
                    },
                    "hour": {
                      "title": "Hour",
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 23,
                      "default": 0
                    }
                  }
                },
                {
                  "title": "Weekly",
                  "properties": {
                    "type": {
                      "const": "weekly"
                    },
                    "dayOfMonth": {
                      "const": "*"
                    },
                    "dayOfWeek": {
                      "title": "Day of the Week",
                      "type": "string",
                      "oneOf": [
                        {
                          "const": "1",
                          "title": "Monday"
                        },
                        {
                          "const": "2",
                          "title": "Tuesday"
                        },
                        {
                          "const": "3",
                          "title": "Wednesday"
                        },
                        {
                          "const": "4",
                          "title": "Thursday"
                        },
                        {
                          "const": "5",
                          "title": "Friday"
                        },
                        {
                          "const": "6",
                          "title": "Saturday"
                        },
                        {
                          "const": "0",
                          "title": "Sunday"
                        }
                      ],
                      "default": "1"
                    },
                    "hour": {
                      "title": "Hour",
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 23,
                      "default": 0
                    }
                  }
                },
                {
                  "title": "Daily",
                  "properties": {
                    "type": {
                      "const": "daily"
                    },
                    "dayOfMonth": {
                      "const": "*"
                    },
                    "dayOfWeek": {
                      "const": "*"
                    },
                    "hour": {
                      "title": "Hour",
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 23,
                      "default": 0
                    }
                  }
                },
                {
                  "title": "Each # Hours",
                  "properties": {
                    "type": {
                      "const": "hours"
                    },
                    "dayOfMonth": {
                      "const": "*"
                    },
                    "dayOfWeek": {
                      "const": "*"
                    },
                    "hour": {
                      "const": "*"
                    },
                    "hourStep": {
                      "title": "Interval in Hours",
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 12,
                      "default": 1
                    }
                  }
                }
              ],
              "properties": {
                "month": {
                  "const": "*"
                },
                "minute": {
                  "title": "Minute",
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 59,
                  "default": 0
                },
                "timeZone": {
                  "type": "string",
                  "title": "Time Zone",
                  "default": "Europe/Paris"
                }
              }
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "id"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": false
      },
      "security": [
        {
          "sdCookie": []
        },
        {
          "oauth2": [
            "processings:write"
          ]
        },
        {
          "oauth2": [
            "processings:admin"
          ]
        },
        {
          "oauth2": [
            "processings"
          ]
        },
        {
          "oauth2": [
            "all:write"
          ]
        },
        {
          "oauth2": [
            "all:admin"
          ]
        }
      ]
