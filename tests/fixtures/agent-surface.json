    {
      "name": "update_processing_permissions",
      "description": "Replace the whole permissions list of a processing, which gives other users or partner organizations a read or exec profile on it, or give the processing to another owner. Read the current permissions first with describe_processing: the list sent replaces them all.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Id of the processing."
          },
          "permissions": {
            "type": "array",
            "title": "Permissions",
            "items": {
              "title": "permission",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "profile",
                "target"
              ],
              "properties": {
                "profile": {
                  "type": "string",
                  "title": "Profile",
                  "default": "read",
                  "oneOf": [
                    {
                      "const": "read",
                      "title": "Read - gives access to the essential information of the processing, logs included, but not to the sensitive information"
                    },
                    {
                      "const": "exec",
                      "title": "Execution - gives access to the essential information of the processing and allows triggering it"
                    }
                  ]
                },
                "target": {
                  "type": "object",
                  "oneOf": [
                    {
                      "title": "User designated by their email",
                      "required": [
                        "email"
                      ],
                      "properties": {
                        "type": {
                          "const": "userEmail"
                        },
                        "email": {
                          "type": "string",
                          "title": "Email"
                        }
                      }
                    },
                    {
                      "title": "Partner organization",
                      "required": [
                        "organization",
                        "roles"
                      ],
                      "properties": {
                        "type": {
                          "const": "partner"
                        },
                        "organization": {
                          "type": "object",
                          "title": "Organization",
                          "additionalProperties": true,
                          "properties": {
                            "id": {
                              "type": "string"
                            },
                            "name": {
                              "type": "string"
                            }
                          }
                        },
                        "roles": {
                          "type": "array",
                          "title": "Roles",
                          "default": [
                            "admin"
                          ],
                          "items": {
                            "type": "string",
                            "enum": [
                              "admin",
                              "contrib",
                              "user"
                            ]
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "owner": {
            "type": "object",
            "title": "account",
            "required": [
              "type",
              "id",
              "name"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "user",
                  "organization"
                ]
              },
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "department": {
                "type": "string"
              },
              "departmentName": {
                "type": "string"
              }
            }
          },
          "processingTitle": {
            "type": "string",
            "description": "The title of the processing, as the API gives it. The call is refused unless it matches.",
            "x-checked": {
              "against": "id",
              "field": "/title"
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "processingTitle"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "openWorldHint": false
      },
      "security": [
        {
          "sdCookie": []
        },
        {
          "oauth2": [
            "processings:admin"
          ]
        },
        {
          "oauth2": [
            "processings"
          ]
        },
        {
          "oauth2": [
            "all:admin"
          ]
        }
      ]
    },
    {
