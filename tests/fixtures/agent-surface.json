    {
      "name": "form_setFieldValue",
      "description": "Set the value of a specific field of the form by path. To switch a variant selector, set value to the desired variant index (shown in describeState); the answer then lists the fields of the branch it activated. The returned errors are scoped to the modified field.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "form": {
            "type": "string",
            "enum": [
              "processing_config"
            ],
            "description": "The form this call edits. \"processing_config\": Processing config. A form keeps its edits between calls with the same form and parameters."
          },
          "id": {
            "type": "string",
            "description": "Id of the processing."
          },
          "path": {
            "type": "string",
            "description": "Node path as returned by describeState (e.g. \"/address/city\")."
          },
          "value": {
            "description": "The value to set. For variant-selector fields, pass the variant index to switch variants. Exclusive with \"suggestionIndex\"."
          },
          "suggestionIndex": {
            "type": "number",
            "description": "Index from the last getFieldSuggestions call on this same path. Exclusive with \"value\"."
          },
          "suggestionTitle": {
            "type": "string",
            "description": "The title getFieldSuggestions gave the suggestion at \"suggestionIndex\", copied as listed. Checked: the write is refused if it is not that suggestion's title. Pass it with every suggestionIndex, so that the call says which option it picks.",
            "x-checked": {
              "against": "suggestionIndex",
              "field": "/title"
            }
          },
          "item": {
            "type": "object",
            "description": "Optional check of the list item this write applies to: keys and values that item must hold, e.g. { \"uuid\": \"a1b2\" } or { \"type\": \"title\" }. The write is refused, and nothing written, if the item at that position does not hold them. It makes a positional path such as /elements/1 say which item it means.",
            "x-checked": {
              "against": "path",
              "field": ""
            }
          },
          "save": {
            "type": "boolean",
            "description": "Save the form after this write, when the write leaves it valid (default false)."
          }
        },
        "required": [
          "form",
          "id",
          "path"
        ]
      },
      "annotations": {
        "title": "Processing config — set a field",
        "readOnlyHint": false,
        "openWorldHint": false
      },
