    {
      "name": "form_setData",
      "description": "Write several fields of the form at once: the given keys are merged into the current data, nested objects included; arrays you pass replace the existing ones. Pass only the keys that change: the ones you leave out stay as they are, and data re-sent unchanged reads, to whoever approves the call, as content being replaced. To change one item of a list, use setFieldValue on its field rather than re-sending the list. Check the errors and warnings in the response.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "form": {
            "type": "string",
            "enum": [
              "processing_config"
            ],
            "description": "The form this call edits. \"processing_config\": Processing config. A form keeps its edits between calls with the same form and parameters."
          },
          "id": {
            "type": "string",
            "description": "Id of the processing."
          },
          "data": {
            "description": "The form data object to set"
          },
          "merge": {
            "type": "boolean",
            "description": "Merge the given keys into the existing data, nested objects included (default); arrays you pass replace the existing ones. Set false to replace the whole object, which removes every key you do not pass."
          },
          "save": {
            "type": "boolean",
            "description": "Save the form after this write, when the write leaves it valid (default false)."
          }
        },
        "required": [
          "form",
          "id",
          "data"
        ]
      },
      "annotations": {
        "title": "Processing config — set fields",
