{
  "tools": [
    {
      "name": "list_processings",
      "description": "List the processings of the active account: periodic or on-demand tasks that run a plugin to ingest, transform or publish datasets. Each result tells its plugin, whether it is active, its last run and next scheduled run, and the profile of the caller on it (admin, exec or read). Use describe_processing for one processing.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "size": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of processings per page.",
            "default": 10,
            "maximum": 50
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "description": "Page number, starting at 1.",
            "default": 1
          },
          "q": {
            "type": "string",
            "description": "Full text search on the titles."
          },
          "statuses": {
            "type": "string",
            "description": "Statuses of the last run, comma separated: triggered, scheduled, running, error, finished, kill, killed."
          },
          "plugins": {
            "type": "string",
            "description": "Plugin ids, comma separated."
          },
          "response_format": {
            "type": "string",
            "enum": [
              "concise",
              "detailed"
            ],
            "default": "concise",
            "description": "concise: _id, title, plugin, active, lastRun, nextRun, userProfile. detailed: every field."
          }
        },
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      },
      "security": [
        {
          "sdCookie": []
        },
        {
          "oauth2": [
            "processings:read"
          ]
        },
        {
          "oauth2": [
            "processings:write"
          ]
        },
        {
          "oauth2": [
            "processings:admin"
          ]
        },
        {
          "oauth2": [
            "processings"
          ]
        },
        {
          "oauth2": [
            "all:read"
          ]
        },
        {
          "oauth2": [
            "all:write"
          ]
        },
        {
          "oauth2": [
            "all:admin"
          ]
        }
      ]
    },
    {
      "name": "create_processing",
      "description": "Create a processing of a plugin. The plugin id is the _id of a processing artefact found with registry_search_artefacts (category processing). The owner defaults to the active account. The processing is created inactive and without config: fill its config next with the form_* tools (form \"processings_processing_config\"), then activate it with update_processing.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "plugin": {
            "type": "string",
            "description": "Registry artefact id of the plugin (e.g. @data-fair-processing-hello-world-1)."
          },
          "owner": {
            "type": "object",
            "title": "account",
            "required": [
              "type",
              "id",
              "name"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "user",
                  "organization"
                ]
              },
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "department": {
                "type": "string"
              },
              "departmentName": {
                "type": "string"
              }
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "title",
          "plugin"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": false
      },
      "security": [
        {
          "sdCookie": []
        },
        {
          "oauth2": [
            "processings:write"
          ]
        },
