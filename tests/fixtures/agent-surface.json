    {
      "name": "form_editArray",
      "description": "Add, remove or move items in an array field of the form. Use describeState to see current array contents. When adding an item it is activated for edition and its children fields are returned, they can then be filled with setFieldValue. The returned errors are scoped to this array. Moving an item keeps its data, so reorder with move rather than adding and removing.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "form": {
            "type": "string",
            "enum": [
              "processing_config"
            ],
            "description": "The form this call edits. \"processing_config\": Processing config. A form keeps its edits between calls with the same form and parameters."
          },
          "id": {
            "type": "string",
            "description": "Id of the processing."
          },
          "path": {
            "type": "string",
            "description": "Node path as returned by describeState (e.g. \"/address/city\"). Must be an array field."
          },
          "action": {
            "type": "string",
            "enum": [
              "add",
              "remove",
              "move"
            ],
            "description": "\"add\" to insert an item, \"remove\" to delete one, \"move\" to put an item at another place in the list"
          },
          "index": {
            "type": "number",
            "description": "Index to insert at (for add, defaults to end) or remove from (for remove, defaults to last)"
          },
          "from": {
            "type": "number",
            "description": "Index of the item to move (move only, required)"
          },
          "to": {
            "type": "number",
            "description": "Index the item should have afterwards (move only, required)"
          },
          "item": {
            "type": "object",
            "description": "Optional check of the list item this write applies to: keys and values that item must hold, e.g. { \"uuid\": \"a1b2\" } or { \"type\": \"title\" }. The write is refused, and nothing written, if the item at that position does not hold them. It makes a positional path such as /elements/1 say which item it means. For remove and move it checks the item removed or moved; for add, the list item the array is in, if any.",
            "x-checked": {
              "against": "path",
              "field": ""
            }
          },
          "value": {
            "description": "Value for the new item (for add action). For an item that is a choice between options, choose its option by the discriminator value describeState lists for it, e.g. { \"type\": \"...\" }: \"$oneOf\" is a path segment, not a data key. Or omit the value and choose the option afterwards with setFieldValue on the item's $oneOf."
          },
          "save": {
            "type": "boolean",
            "description": "Save the form after this write, when the write leaves it valid (default false)."
          }
        },
        "required": [
          "form",
          "id",
          "path",
          "action"
        ]
      },
