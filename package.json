{
  "name": "@data-fair/processings",
  "version": "6.3.1",
  "description": "",
  "type": "module",
  "scripts": {
    "build-types": "df-build-types ./",
    "check-types": "tsc && npm -w ui run check-types",
    "dev-zellij": "df-dev zellij",
    "lint": "eslint . && npm -w ui run lint",
    "lint-fix": "eslint --fix . && npm -w ui run lint-fix",
    "prepare": "husky || true",
    "stop-dev-deps": "docker compose --profile '*' stop",
    "test": "playwright test",
    "test-unit": "playwright test --project=unit",
    "test-api": "playwright test --project=api",
    "test-api-fast": "playwright test --project=api --max-failures=1",
    "test-e2e": "playwright test --project=e2e",
    "quality": "npm run lint && npm run build-types && npm -w ui run build && npm run check-types && npm test && npm audit --omit=dev --audit-level=critical"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/data-fair/processings.git"
  },
  "author": "",
  "license": "AGPL-3.0-only",
  "workspaces": [
    "ui",
    "api",
    "worker",
    "shared"
  ],
  "relativeDependencies": {
    "@data-fair/lib-vue": "../lib/packages/vue",
    "@data-fair/lib-vuetify": "../lib/packages/vuetify"
  },
  "bugs": {
    "url": "https://github.com/data-fair/processings/issues"
  },
  "homepage": "https://github.com/data-fair/processings#readme",
  "engines": {
    "node": "v24"
  },
  "dependencies": {
    "@data-fair/lib-types-builder": "^1.14.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@data-fair/lib-common-types": "^1.23.0",
    "@data-fair/lib-dev": "^0.1.0",
    "@data-fair/lib-node": "^2.16.1",
    "@data-fair/lib-utils": "^1.14.0",
    "@playwright/test": "^1.52.0",
    "@types/config": "^3.3.5",
    "@types/debug": "^4.1.12",
    "dotenv": "^16.4.5",
    "dotenv-cli": "^7.4.4",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "eslint-plugin-vuetify": "^2.7.3",
    "form-data": "^4.0.6",
    "husky": "^9.1.7",
    "neostandard": "^0.14.1",
    "nodemon": "^3.1.14",
    "tough-cookie": "^5.0.0",
    "typescript": "^6.0.3"
  }
}
